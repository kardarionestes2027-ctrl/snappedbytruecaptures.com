<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SnappedBy True Capture | Sports Photography</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#0D1210;
    --ink-2:#161C19;
    --ink-3:#1F2621;
    --chalk:#F0EDE4;
    --chalk-dim:#B9BDB4;
    --amber:#FFB627;
    --amber-dim:#8A6318;
    --turf:#3E6B4F;
    --turf-bright:#5B9270;
    --jersey:#A6303B;
    --line:#2A332D;
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    background:var(--ink);
    color:var(--chalk);
    font-family:'Inter',sans-serif;
    line-height:1.6;
    overflow-x:hidden;
  }
  h1,h2,h3,.display{
    font-family:'Anton',sans-serif;
    font-weight:400;
    text-transform:uppercase;
    letter-spacing:0.02em;
    line-height:0.95;
  }
  .mono{font-family:'JetBrains Mono',monospace;}
  a{color:inherit;text-decoration:none;}
  .wrap{max-width:1180px;margin:0 auto;padding:0 24px;}
  ::selection{background:var(--amber);color:var(--ink);}

  /* Focus visibility */
  a:focus-visible,button:focus-visible{outline:2px solid var(--amber);outline-offset:3px;}

  @media (prefers-reduced-motion: reduce){
    *{animation-duration:0.001ms !important;animation-iteration-count:1 !important;transition-duration:0.001ms !important;}
  }

  /* ---------- NAV ---------- */
  header{
    position:fixed;top:0;left:0;right:0;z-index:100;
    background:rgba(13,18,16,0.88);
    backdrop-filter:blur(8px);
    border-bottom:1px solid var(--line);
  }
  nav.wrap{
    display:flex;align-items:center;justify-content:space-between;
    padding-top:16px;padding-bottom:16px;
  }
  .brand{
    font-family:'Anton',sans-serif;
    font-size:1.25rem;
    letter-spacing:0.03em;
    display:flex;align-items:center;gap:10px;
  }
  .brand-dot{width:9px;height:9px;background:var(--amber);border-radius:50%;box-shadow:0 0 10px var(--amber);}
  .nav-links{display:flex;gap:28px;font-size:0.85rem;letter-spacing:0.06em;text-transform:uppercase;font-weight:600;}
  .nav-links a{color:var(--chalk-dim);transition:color .2s;position:relative;}
  .nav-links a:hover{color:var(--amber);}
  .nav-cta{
    background:var(--amber);color:var(--ink);
    padding:10px 20px;font-weight:700;font-size:0.8rem;
    letter-spacing:0.06em;text-transform:uppercase;
    border-radius:2px;
  }
  .nav-cta:hover{background:var(--chalk);}
  .menu-btn{display:none;background:none;border:1px solid var(--line);color:var(--chalk);padding:8px 12px;font-size:1.2rem;}

  @media(max-width:860px){
    .nav-links{display:none;}
    .menu-btn{display:block;}
    .nav-cta{display:none;}
  }

  /* ---------- HERO ---------- */
  .hero{
    position:relative;
    min-height:100vh;
    display:flex;align-items:flex-end;
    padding-bottom:90px;
    padding-top:140px;
    background:
      radial-gradient(ellipse 900px 500px at 20% -10%, rgba(255,182,39,0.16), transparent 60%),
      radial-gradient(ellipse 700px 500px at 90% 10%, rgba(62,107,79,0.20), transparent 60%),
      linear-gradient(180deg, var(--ink) 0%, #0A0D0B 100%);
    overflow:hidden;
  }
  .hero::before{
    content:"";
    position:absolute;inset:0;
    background-image:
      repeating-linear-gradient(90deg, rgba(240,237,228,0.035) 0px, rgba(240,237,228,0.035) 1px, transparent 1px, transparent 120px);
    pointer-events:none;
  }
  .floodbeam{
    position:absolute;top:-20%;left:50%;
    width:1400px;height:1400px;
    transform:translateX(-50%);
    background:conic-gradient(from 200deg at 50% 0%, transparent 0deg, rgba(255,182,39,0.10) 8deg, transparent 20deg);
    animation:sweep 14s ease-in-out infinite;
    pointer-events:none;
  }
  @keyframes sweep{
    0%,100%{transform:translateX(-58%) rotate(0deg);}
    50%{transform:translateX(-42%) rotate(0deg);}
  }
  .hero-inner{position:relative;z-index:2;}
  .eyebrow{
    font-family:'JetBrains Mono',monospace;
    font-size:0.78rem;color:var(--amber);
    letter-spacing:0.18em;text-transform:uppercase;
    display:flex;align-items:center;gap:10px;margin-bottom:22px;
  }
  .eyebrow::before{content:"";width:26px;height:1px;background:var(--amber);}
  .hero h1{
    font-size:clamp(3rem,8vw,6.4rem);
    color:var(--chalk);
    max-width:900px;
  }
  .hero h1 span{color:var(--amber);}
  .hero p.sub{
    max-width:520px;margin-top:26px;
    color:var(--chalk-dim);font-size:1.05rem;
  }
  .hero-ctas{display:flex;gap:16px;margin-top:38px;flex-wrap:wrap;}
  .btn-primary{
    background:var(--amber);color:var(--ink);
    padding:15px 30px;font-weight:700;font-size:0.85rem;
    letter-spacing:0.06em;text-transform:uppercase;
    border-radius:2px;transition:transform .15s, background .2s;
    display:inline-block;
  }
  .btn-primary:hover{background:var(--chalk);transform:translateY(-2px);}
  .btn-ghost{
    border:1px solid var(--line);color:var(--chalk);
    padding:15px 30px;font-weight:700;font-size:0.85rem;
    letter-spacing:0.06em;text-transform:uppercase;
    border-radius:2px;transition:border-color .2s, color .2s;
    display:inline-block;
  }
  .btn-ghost:hover{border-color:var(--amber);color:var(--amber);}

  .hero-stats{
    position:absolute;right:24px;bottom:90px;
    display:flex;gap:36px;z-index:2;
  }
  @media(max-width:860px){.hero-stats{display:none;}}
  .stat{text-align:right;}
  .stat .num{font-family:'JetBrains Mono',monospace;font-size:1.9rem;color:var(--amber);font-weight:700;}
  .stat .label{font-size:0.7rem;color:var(--chalk-dim);letter-spacing:0.08em;text-transform:uppercase;}

  /* ---------- SECTION SHARED ---------- */
  section{padding:110px 0;position:relative;}
  .section-head{margin-bottom:60px;max-width:640px;}
  .section-tag{
    font-family:'JetBrains Mono',monospace;color:var(--amber);
    font-size:0.78rem;letter-spacing:0.16em;text-transform:uppercase;
    margin-bottom:14px;display:block;
  }
  .section-head h2{font-size:clamp(2.1rem,4.5vw,3.4rem);color:var(--chalk);}
  .section-head p{color:var(--chalk-dim);margin-top:16px;font-size:1.02rem;}
  .hr{height:1px;background:var(--line);border:none;}

  /* ---------- SERVICES ---------- */
  .services-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);border:1px solid var(--line);}
  @media(max-width:900px){.services-grid{grid-template-columns:1fr;}}
  .service-card{background:var(--ink);padding:44px 34px;transition:background .25s;}
  .service-card:hover{background:var(--ink-2);}
  .service-icon{
    width:46px;height:46px;border:1px solid var(--amber);border-radius:50%;
    display:flex;align-items:center;justify-content:center;margin-bottom:26px;
    color:var(--amber);font-family:'JetBrains Mono',monospace;font-size:0.9rem;font-weight:700;
  }
  .service-card h3{font-size:1.5rem;color:var(--chalk);margin-bottom:12px;}
  .service-card p{color:var(--chalk-dim);font-size:0.95rem;margin-bottom:22px;}
  .service-from{font-family:'JetBrains Mono',monospace;color:var(--amber);font-size:0.85rem;letter-spacing:0.04em;}
  .service-from b{font-size:1.3rem;}

  /* ---------- PRICING / SCOREBOARD ---------- */
  .pricing-tabs{display:flex;gap:10px;margin-bottom:44px;flex-wrap:wrap;}
  .tab-btn{
    font-family:'JetBrains Mono',monospace;font-size:0.8rem;letter-spacing:0.05em;
    text-transform:uppercase;padding:11px 22px;border:1px solid var(--line);
    background:transparent;color:var(--chalk-dim);cursor:pointer;border-radius:2px;
    transition:all .2s;
  }
  .tab-btn.active,.tab-btn:hover{border-color:var(--amber);color:var(--amber);}
  .board{
    background:var(--ink-2);border:1px solid var(--line);border-radius:4px;
    padding:8px;display:none;
  }
  .board.active{display:block;}
  .board-row{
    display:grid;grid-template-columns:1.3fr 1fr 0.9fr;gap:20px;
    align-items:center;padding:26px 24px;border-bottom:1px solid var(--line);
  }
  .board-row:last-child{border-bottom:none;}
  .board-row.head{
    font-family:'JetBrains Mono',monospace;font-size:0.72rem;color:var(--chalk-dim);
    text-transform:uppercase;letter-spacing:0.1em;padding-top:14px;padding-bottom:14px;
  }
  @media(max-width:700px){
    .board-row{grid-template-columns:1fr;gap:8px;text-align:left;}
    .board-row.head{display:none;}
  }
  .pkg-name{font-family:'Anton',sans-serif;font-size:1.4rem;color:var(--chalk);text-transform:uppercase;}
  .pkg-desc{color:var(--chalk-dim);font-size:0.88rem;margin-top:6px;}
  .pkg-price{
    font-family:'JetBrains Mono',monospace;font-size:1.7rem;color:var(--amber);font-weight:700;
    text-shadow:0 0 18px rgba(255,182,39,0.35);
  }
  .pkg-price span{font-size:0.85rem;color:var(--chalk-dim);text-shadow:none;}
  .pkg-cta{
    justify-self:end;border:1px solid var(--amber);color:var(--amber);
    padding:10px 18px;font-family:'JetBrains Mono',monospace;font-size:0.75rem;
    text-transform:uppercase;letter-spacing:0.06em;border-radius:2px;transition:all .2s;
  }
  @media(max-width:700px){.pkg-cta{justify-self:start;}}
  .pkg-cta:hover{background:var(--amber);color:var(--ink);}
  .addons{margin-top:26px;color:var(--chalk-dim);font-size:0.88rem;padding:0 6px;}
  .addons b{color:var(--chalk);}
  .price-note{margin-top:18px;font-size:0.8rem;color:var(--chalk-dim);font-style:italic;}

  /* ---------- BOOK WITH ---------- */
  .brand-grid{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--line);border:1px solid var(--line);}
  @media(max-width:700px){.brand-grid{grid-template-columns:1fr;}}
  .brand-card{background:var(--ink);padding:40px 34px;transition:background .25s;}
  .brand-card:hover{background:var(--ink-2);}
  .brand-card h3{font-size:1.6rem;color:var(--chalk);margin:22px 0 20px;}
  .brand-card .info-row{margin-bottom:14px;}

  /* ---------- GALLERY ---------- */
  .gallery-grid{
    display:grid;grid-template-columns:repeat(4,1fr);gap:12px;
  }
  @media(max-width:900px){.gallery-grid{grid-template-columns:repeat(2,1fr);}}
  .slot{
    aspect-ratio:4/5;border:1px dashed var(--line);
    display:flex;flex-direction:column;align-items:center;justify-content:center;
    gap:10px;color:var(--chalk-dim);background:var(--ink-2);
    transition:border-color .2s,color .2s;
  }
  .slot:hover{border-color:var(--amber);color:var(--amber);}
  .slot .plus{font-size:1.6rem;font-family:'JetBrains Mono',monospace;}
  .slot .cap{font-size:0.72rem;letter-spacing:0.06em;text-transform:uppercase;font-family:'JetBrains Mono',monospace;}
  .slot.tall{grid-row:span 2;aspect-ratio:auto;}
  .slot.filled{border:1px solid var(--line);padding:0;overflow:hidden;position:relative;}
  .slot.filled img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .4s ease;}
  .slot.filled:hover img{transform:scale(1.05);}
  .slot.filled:hover{border-color:var(--amber);}


  .portfolio-label{display:flex;align-items:center;gap:16px;margin:6px 0 18px;}
  .portfolio-label>span{width:46px;height:46px;border-radius:50%;border:1px solid var(--amber);display:flex;align-items:center;justify-content:center;font-family:'JetBrains Mono',monospace;color:var(--amber);font-weight:700;}
  .portfolio-label h3{font-size:1.35rem;}
  .portfolio-label p{color:var(--chalk-dim);font-size:.82rem;}
  .noble-label{margin-top:44px;}
  .noble-grid{opacity:.9;}
  .noble-placeholder{min-height:260px;}
  .slot.filled::after{content:"SNAPPEDBYK3";position:absolute;right:10px;bottom:10px;color:rgba(255,255,255,.82);font-family:'JetBrains Mono',monospace;font-weight:700;font-size:.72rem;letter-spacing:.08em;text-shadow:0 1px 5px rgba(0,0,0,.8);pointer-events:none;z-index:2;}
  .brand-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:24px;}
  .brand-actions .btn-primary,.brand-actions .btn-ghost{padding:11px 18px;font-size:.75rem;}
  .brand-card a:hover,.contact-info a:hover{color:var(--amber);}

  /* ---------- PROCESS ---------- */
  .process{display:grid;grid-template-columns:repeat(4,1fr);gap:0;border-top:1px solid var(--line);border-left:1px solid var(--line);}
  @media(max-width:900px){.process{grid-template-columns:1fr 1fr;}}
  @media(max-width:560px){.process{grid-template-columns:1fr;}}
  .step{padding:34px 28px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);}
  .step .qtr{font-family:'JetBrains Mono',monospace;color:var(--amber-dim);font-size:0.78rem;letter-spacing:0.1em;}
  .step h3{font-size:1.25rem;margin:10px 0 10px;color:var(--chalk);}
  .step p{color:var(--chalk-dim);font-size:0.9rem;}

  /* ---------- CONTACT ---------- */
  .contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:60px;}
  @media(max-width:860px){.contact-grid{grid-template-columns:1fr;gap:40px;}}
  .field{margin-bottom:20px;}
  .field label{display:block;font-family:'JetBrains Mono',monospace;font-size:0.72rem;text-transform:uppercase;letter-spacing:0.08em;color:var(--chalk-dim);margin-bottom:8px;}
  .field input,.field select,.field textarea{
    width:100%;background:var(--ink-2);border:1px solid var(--line);color:var(--chalk);
    padding:13px 14px;font-family:'Inter',sans-serif;font-size:0.95rem;border-radius:2px;
  }
  .field input:focus,.field select:focus,.field textarea:focus{outline:none;border-color:var(--amber);}
  .field textarea{resize:vertical;min-height:100px;}
  .contact-info h3{font-size:1.6rem;margin-bottom:18px;color:var(--chalk);}
  .contact-info p{color:var(--chalk-dim);margin-bottom:26px;}
  .info-row{display:flex;gap:14px;margin-bottom:18px;font-size:0.92rem;}
  .info-row .k{font-family:'JetBrains Mono',monospace;color:var(--amber);min-width:90px;text-transform:uppercase;font-size:0.75rem;letter-spacing:0.05em;padding-top:2px;}

  /* ---------- FOOTER ---------- */
  footer{border-top:1px solid var(--line);padding:36px 0;}
  .foot-row{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:14px;}
  .foot-row .brand{font-size:1rem;}
  .foot-row .copy{color:var(--chalk-dim);font-size:0.8rem;}

  .noble-grid .slot.filled::after{content:"SNAPPEDBYNOBLE";}


  /* ===== DRAMATIC STADIUM / NEON UPGRADE ===== */
  :root{
    --electric:#71F6FF;
    --violet:#A777FF;
    --hot:#FF3D8D;
    --gold:#FFD166;
    --glass:rgba(15,22,20,.72);
  }

  body{
    background:
      radial-gradient(circle at 12% 8%, rgba(113,246,255,.10), transparent 28%),
      radial-gradient(circle at 88% 18%, rgba(167,119,255,.12), transparent 30%),
      radial-gradient(circle at 50% 85%, rgba(255,61,141,.08), transparent 30%),
      linear-gradient(180deg,#070A09 0%,#0B100E 42%,#070A09 100%);
    background-attachment:fixed;
  }
  body::before{
    content:"";position:fixed;inset:0;z-index:-2;pointer-events:none;
    background-image:
      linear-gradient(rgba(255,255,255,.018) 1px,transparent 1px),
      linear-gradient(90deg,rgba(255,255,255,.018) 1px,transparent 1px);
    background-size:44px 44px;
    mask-image:linear-gradient(to bottom,rgba(0,0,0,.8),transparent 90%);
  }
  body::after{
    content:"";position:fixed;inset:-30%;z-index:-1;pointer-events:none;
    background:conic-gradient(from 0deg,
      transparent 0deg,rgba(113,246,255,.05) 35deg,transparent 70deg,
      rgba(167,119,255,.05) 150deg,transparent 210deg,
      rgba(255,61,141,.04) 280deg,transparent 340deg);
    filter:blur(60px);
    animation:ambientSpin 24s linear infinite;
  }
  @keyframes ambientSpin{to{transform:rotate(360deg)}}

  header{
    background:linear-gradient(180deg,rgba(5,8,7,.94),rgba(8,12,10,.80));
    box-shadow:0 8px 36px rgba(0,0,0,.45),0 1px 0 rgba(113,246,255,.13);
  }
  .brand{font-size:1.08rem;letter-spacing:.08em;text-shadow:0 0 20px rgba(113,246,255,.45)}
  .brand-dot{
    background:var(--electric);box-shadow:0 0 8px var(--electric),0 0 18px var(--electric),0 0 34px rgba(113,246,255,.8);
    animation:brandPulse 2.4s ease-in-out infinite;
  }
  @keyframes brandPulse{50%{transform:scale(1.45);filter:brightness(1.45)}}

  .hero{
    min-height:100svh;
    background:
      linear-gradient(180deg,rgba(5,8,7,.12),rgba(5,8,7,.88)),
      radial-gradient(ellipse 850px 520px at 12% 10%,rgba(113,246,255,.20),transparent 62%),
      radial-gradient(ellipse 850px 520px at 88% 12%,rgba(167,119,255,.22),transparent 62%),
      radial-gradient(ellipse 900px 480px at 50% 95%,rgba(255,182,39,.14),transparent 68%),
      linear-gradient(145deg,#090D0B 0%,#111816 45%,#080A09 100%);
  }
  .hero::before{
    background-image:
      linear-gradient(90deg,transparent 0 8%,rgba(113,246,255,.05) 8.1% 8.2%,transparent 8.3% 91%,rgba(167,119,255,.05) 91.1% 91.2%,transparent 91.3%),
      repeating-linear-gradient(90deg,rgba(255,255,255,.025) 0 1px,transparent 1px 100px);
  }
  .hero::after{
    content:"";position:absolute;inset:auto -12% -34% -12%;height:70%;pointer-events:none;
    background:
      radial-gradient(ellipse at 20% 100%,rgba(113,246,255,.22),transparent 52%),
      radial-gradient(ellipse at 80% 100%,rgba(167,119,255,.22),transparent 52%);
    filter:blur(28px);opacity:.85;animation:heroGlow 7s ease-in-out infinite alternate;
  }
  @keyframes heroGlow{to{transform:translateY(-18px) scale(1.04);opacity:1}}
  .floodbeam{
    width:1700px;height:1700px;top:-38%;
    background:conic-gradient(from 197deg at 50% 0%,transparent 0 4deg,rgba(113,246,255,.13) 8deg,transparent 18deg 28deg,rgba(255,182,39,.10) 32deg,transparent 43deg);
    filter:blur(1px);
  }
  .hero h1{
    font-size:clamp(3.6rem,9.8vw,8.6rem);
    text-shadow:0 8px 34px rgba(0,0,0,.62),0 0 52px rgba(240,237,228,.06);
  }
  .hero h1 span{
    background:linear-gradient(90deg,var(--amber),var(--gold),var(--electric),var(--violet));
    -webkit-background-clip:text;background-clip:text;color:transparent;
    filter:drop-shadow(0 0 14px rgba(255,182,39,.34));
  }
  .eyebrow{color:var(--electric);text-shadow:0 0 14px rgba(113,246,255,.55)}
  .eyebrow::before{background:var(--electric);box-shadow:0 0 10px var(--electric)}
  .hero p.sub{font-size:1.12rem;max-width:650px;color:#D9DED8;text-shadow:0 2px 20px rgba(0,0,0,.7)}
  .hero-stats{padding:18px 20px;background:rgba(9,14,12,.48);border:1px solid rgba(113,246,255,.14);backdrop-filter:blur(10px);box-shadow:0 18px 60px rgba(0,0,0,.34)}
  .stat .num{color:var(--electric);text-shadow:0 0 18px rgba(113,246,255,.55)}

  section{isolation:isolate}
  section:nth-of-type(even)::before{
    content:"";position:absolute;inset:8% -8%;z-index:-1;pointer-events:none;
    background:radial-gradient(ellipse at 100% 50%,rgba(167,119,255,.055),transparent 50%);
  }
  .section-tag{color:var(--electric);text-shadow:0 0 12px rgba(113,246,255,.35)}
  .section-head h2{text-shadow:0 5px 26px rgba(0,0,0,.45)}

  .services-grid,.brand-grid,.process{box-shadow:0 25px 90px rgba(0,0,0,.28)}
  .service-card,.brand-card,.step,.board{
    background:linear-gradient(145deg,rgba(18,27,23,.82),rgba(10,15,13,.92));
    backdrop-filter:blur(10px);
  }
  .service-card,.brand-card{
    position:relative;overflow:hidden;
  }
  .service-card::before,.brand-card::before{
    content:"";position:absolute;inset:0;pointer-events:none;
    background:linear-gradient(120deg,transparent 0 35%,rgba(255,255,255,.045) 48%,transparent 61%);
    transform:translateX(-120%);transition:transform .8s ease;
  }
  .service-card:hover::before,.brand-card:hover::before{transform:translateX(120%)}
  .service-card:hover,.brand-card:hover{box-shadow:inset 0 0 0 1px rgba(113,246,255,.17),0 20px 48px rgba(0,0,0,.28)}
  .service-icon{border-color:var(--electric);color:var(--electric);box-shadow:0 0 18px rgba(113,246,255,.16),inset 0 0 15px rgba(113,246,255,.07)}

  .btn-primary{
    background:linear-gradient(100deg,var(--amber),#FFD86B);
    box-shadow:0 8px 28px rgba(255,182,39,.25),0 0 0 1px rgba(255,255,255,.08) inset;
    position:relative;overflow:hidden;
  }
  .btn-primary:hover{box-shadow:0 12px 40px rgba(255,182,39,.40);transform:translateY(-3px) scale(1.015)}
  .btn-ghost{background:rgba(9,14,12,.38);backdrop-filter:blur(8px)}
